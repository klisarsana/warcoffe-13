# ============================================================
# WARCOFFE 13 MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES
# Capstone Project Asah 2026 | Team ID: A26-CS187
# ============================================================
# Cara pakai:
#   cp .env.example .env.local
#   lalu isi nilainya.
#
# JANGAN commit .env.local atau key asli ke repository.
# Di Vercel, tambahkan variabel yang sama lewat Project Settings → Environment Variables.
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTH
# ------------------------------------------------------------
# Wajib. Ambil dari Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Pilih SALAH SATU key di bawah ini.
# Format baru (disarankan):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Format lama (kompatibilitas):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk CLI `npm run seed` dari lokal.
# JANGAN tambahkan ke Vercel, JANGAN memakai prefix NEXT_PUBLIC_.
# Jika memakai supabase/seed.sql, variabel ini tidak diperlukan.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# 2. SERVICE AI FASTAPI (OPSIONAL)
# ------------------------------------------------------------
# Untuk pengembangan lokal:
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
#
# Untuk production di Vercel:
# - AI_SERVICE_URL harus URL publik service AI, bukan localhost.
# - Contoh: https://nama-service-ai.example.com
# - NEXT_PUBLIC_AI_SERVICE_URL boleh diisi URL yang sama untuk label/status UI.
#
# Jika AI belum di-deploy, biarkan kosong. Fitur inti tetap berjalan.
