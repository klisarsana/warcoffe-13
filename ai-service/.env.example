# ============================================================
# WARCOFFE 13 AI SERVICE — ENVIRONMENT VARIABLES
# ============================================================
# Cara pakai:
#   cp .env.example .env
#   lalu isi nilainya.
#
# JANGAN commit .env / .env.local atau key asli ke repository.
# Di host production (Hugging Face Spaces, Render, Railway, dll.),
# gunakan fitur Secrets / Environment Variables, bukan file ini.
# ============================================================

# ------------------------------------------------------------
# 1. GEMINI
# ------------------------------------------------------------
# Tanpa API key, endpoint /api/v1/chat tetap berjalan memakai fallback aturan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_TOTAL_BUDGET_SECONDS=10
GEMINI_MAX_OUTPUT_TOKENS=512

# ------------------------------------------------------------
# 2. SERVICE
# ------------------------------------------------------------
# Zona waktu parser tanggal.
TIMEZONE=Asia/Jakarta

# Ambang pencocokan nama menu (0-100).
MENU_MATCH_THRESHOLD=80

# Origin yang diizinkan untuk CORS.
# Untuk lokal:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Untuk production, tambahkan domain Vercel, contoh:
# ALLOWED_ORIGINS=https://domain-vercel-kamu.vercel.app

# ------------------------------------------------------------
# 3. PATH OPSIONAL
# ------------------------------------------------------------
# Default: ai-service/data dan ai-service/models
# Isi hanya jika lokasi file berbeda di host deployment.
AI_DATA_DIR=
AI_MODEL_DIR=

# ------------------------------------------------------------
# CATATAN DEPLOYMENT
# ------------------------------------------------------------
# - Hugging Face Spaces (Docker) menggunakan port 7860.
# - Render/Railway/Cloud Run menggunakan $PORT dari platform.
# - Health check: GET /api/v1/health
# - Jangan menaruh API key di repository atau file yang di-commit.
# - Detail deployment: ../docs/DEPLOYMENT.md
